# Copia este archivo como .streamlit/secrets.toml (está en .gitignore) o
# pega su contenido en Streamlit Cloud → App settings → Secrets.
# También puedes definir estas claves como variables de entorno.

# Secreto HMAC para validar códigos Pro "ZP-XXX-XXXX-XXXXXX".
# Debe ser el MISMO que usa Zajuna Panel para emitir los códigos.
ZP_SECRET = "reemplazar-por-un-secreto-largo-y-aleatorio"

# Opcional: clave del servidor para que el instructor no tenga que pegar la suya.
# Si no se define, cada instructor ingresa su propia clave en la barra lateral.
# OPENROUTER_API_KEY = "sk-or-..."
# OPENAI_API_KEY = "sk-..."
